# Environment configuration for BioInfo REST API

# NCBI E-utilities API Key
# Sign up at https://ncbi.nlm.nih.gov/account/ to get a key
NCBI_API_KEY=your_ncbi_api_key_here

# Redis URL for caching (defaults to localhost:6379)
REDIS_URL=redis://localhost:6379

# CORS Origins (comma-separated list of allowed origins)
# Example: http://localhost:5173,https://myproductionapp.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Deployment environment (development, production)
ENVIRONMENT=development
